    },
    {
      "id": "ch01_mc_b3_q1_choices_10aftk9",
      "type": "text",
      "x": 3695,
      "y": 1167,
      "width": 287,
      "height": 109.2,
      "angle": 0,
      "strokeColor": "#5d6f6c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
