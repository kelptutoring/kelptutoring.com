      "fontFamily": 2,
      "text": "How does an observation differ from a\nhypothesis?",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How does an observation differ from a\nhypothesis?",
      "autoResize": false,
