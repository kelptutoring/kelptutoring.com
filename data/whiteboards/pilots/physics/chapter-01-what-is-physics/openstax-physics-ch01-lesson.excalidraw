    {
      "id": "ch01_mc_b3_q3_choices_kuli03",
      "type": "text",
      "x": 4399,
      "y": 1167,
      "width": 287,
      "height": 93.60000000000001,
      "angle": 0,
      "strokeColor": "#5d6f6c",
      "backgroundColor": "transparent",
