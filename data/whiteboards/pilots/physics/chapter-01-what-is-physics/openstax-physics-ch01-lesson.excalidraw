      "fontFamily": 2,
      "text": "How does the evidence for a theory\ncompare with that for a new hypothesis?",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How does the evidence for a theory\ncompare with that for a new hypothesis?",
      "autoResize": false,
