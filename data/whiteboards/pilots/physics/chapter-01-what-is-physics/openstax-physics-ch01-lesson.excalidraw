      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 12,
      "fontFamily": 2,
      "text": "A. Both begin with no evidence.\nB. A theory has little; a hypothesis has\nmuch.\nC. A theory has substantial supporting\nevidence.\nD. Neither can be tested.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A. Both begin with no evidence.\nB. A theory has little; a hypothesis has\nmuch.\nC. A theory has substantial supporting\nevidence.\nD. Neither can be tested.",
      "autoResize": false,
      "lineHeight": 1.3
    },
