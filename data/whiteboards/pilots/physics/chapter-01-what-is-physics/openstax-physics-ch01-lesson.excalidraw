    },
    {
      "id": "ch01_mc_b4_q2_choices_1jwlqs3",
      "type": "text",
      "x": 5260,
      "y": 1167,
      "width": 287,
      "height": 78,
      "angle": 0,
      "strokeColor": "#5d6f6c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "grp_ch01_mc_b4_q2_5grisx"
      ],
      "frameId": "ch01_frame_multiple-choice-d_zdg2py",
      "index": null,
      "roundness": null,
      "seed": 1542736565,
      "version": 1,
      "versionNonce": 3317904140,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 12,
      "fontFamily": 2,
      "text": "A. Both are held constant.\nB. The dependent variable is controlled.\nC. The independent is changed; the\ndependent responds.\nD. They always change together.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A. Both are held constant.\nB. The dependent variable is controlled.\nC. The independent is changed; the\ndependent responds.\nD. They always change together.",
      "autoResize": false,
      "lineHeight": 1.3
    },
    {
      "id": "ch01_mc_b4_q3_shape_1syhfl",
      "type": "rectangle",
