      "fontFamily": 2,
      "text": "How do independent and dependent\nvariables differ?",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How do independent and dependent\nvariables differ?",
      "autoResize": false,
