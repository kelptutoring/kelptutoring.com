      "verticalAlign": "top",
      "containerId": null,
      "originalText": "After one complete circular orbit, what\nare a shuttle’s distance and\ndisplacement?",
      "autoResize": false,
      "lineHeight": 1.3
    },
    {
      "id": "ch02_mc_b1_q5_choices_49bgow",
      "type": "text",
      "x": 1621,
      "y": 1448,
      "width": 287,
      "height": 93.60000000000001,
      "angle": 0,
      "strokeColor": "#5d6f6c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
