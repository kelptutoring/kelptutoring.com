      "text": "Can a speedometer reading alone\ndetermine a car’s instantaneous\nvelocity?",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Can a speedometer reading alone\ndetermine a car’s instantaneous\nvelocity?",
      "autoResize": false,
