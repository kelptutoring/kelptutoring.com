      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 12,
      "fontFamily": 2,
      "text": "A. Yes, because motion is relative.\nB. Yes, Earth is always the correct\nframe.\nC. No, motion is relative to the chosen\nframe.\nD. No, motion is independent of frames.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A. Yes, because motion is relative.\nB. Yes, Earth is always the correct\nframe.\nC. No, motion is relative to the chosen\nframe.\nD. No, motion is independent of frames.",
      "autoResize": false,
      "lineHeight": 1.3
    },
