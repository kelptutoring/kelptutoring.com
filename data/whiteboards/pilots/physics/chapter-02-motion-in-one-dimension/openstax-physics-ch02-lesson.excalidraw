    {
      "id": "ch02_mc_b2_q4_choices_1kecxq8",
      "type": "text",
      "x": 2482,
      "y": 1448,
      "width": 287,
      "height": 93.60000000000001,
      "angle": 0,
      "strokeColor": "#5d6f6c",
      "backgroundColor": "transparent",
