      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 12,
      "fontFamily": 2,
      "text": "A. No; it gives speed but not direction.\nB. No; it gives only average speed.\nC. Yes, sometimes it gives the full\nvelocity.\nD. Yes, it always gives the full\nvelocity.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A. No; it gives speed but not direction.\nB. No; it gives only average speed.\nC. Yes, sometimes it gives the full\nvelocity.\nD. Yes, it always gives the full\nvelocity.",
