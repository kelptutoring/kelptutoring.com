      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 12,
      "fontFamily": 2,
      "text": "A. Both are zero.\nB. Distance is one circumference;\ndisplacement is zero.\nC. Distance is zero; displacement is one\ncircumference.\nD. Both equal one circumference.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A. Both are zero.\nB. Distance is one circumference;\ndisplacement is zero.\nC. Distance is zero; displacement is one\ncircumference.\nD. Both equal one circumference.",
      "autoResize": false,
      "lineHeight": 1.3
    },
