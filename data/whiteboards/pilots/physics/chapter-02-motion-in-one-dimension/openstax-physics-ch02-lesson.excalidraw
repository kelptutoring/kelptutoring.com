      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 12,
      "fontFamily": 2,
      "text": "A. They are always identical vectors.\nB. They can never be equal.\nC. Speed equals the magnitude of\nvelocity.\nD. Velocity magnitude is always greater.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A. They are always identical vectors.\nB. They can never be equal.\nC. Speed equals the magnitude of\nvelocity.\nD. Velocity magnitude is always greater.",
      "autoResize": false,
      "lineHeight": 1.3
    },
