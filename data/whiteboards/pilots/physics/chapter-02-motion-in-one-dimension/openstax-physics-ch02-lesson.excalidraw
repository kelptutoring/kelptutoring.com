      "fontFamily": 2,
      "text": "Is there one uniquely correct reference\nframe for a moving train?",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Is there one uniquely correct reference\nframe for a moving train?",
      "autoResize": false,
