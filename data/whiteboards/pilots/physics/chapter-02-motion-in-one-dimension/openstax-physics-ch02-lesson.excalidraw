    {
      "id": "ch02_mc_b1_q4_choices_1sxaegn",
      "type": "text",
      "x": 1269,
      "y": 1448,
      "width": 287,
      "height": 93.60000000000001,
      "angle": 0,
      "strokeColor": "#5d6f6c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
